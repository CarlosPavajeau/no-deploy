{
	"name": "no-deploy",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.3.1",
			"zod": "^4.3.6",
			"typescript": "^5.9.3",
			"@types/node": "^22.19.15",
			"better-auth": "^1.5.6"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"dev:native": "turbo -F native dev",
		"dev:web": "turbo -F web dev",
		"db:push": "turbo -F @no-deploy/db db:push",
		"db:studio": "turbo -F @no-deploy/db db:studio",
		"db:generate": "turbo -F @no-deploy/db db:generate",
		"db:migrate": "turbo -F @no-deploy/db db:migrate",
		"format": "oxfmt"
	},
	"dependencies": {
		"@no-deploy/env": "workspace:*",
		"dotenv": "catalog:",
		"nitro": "^3.0.1-alpha.2",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@no-deploy/config": "workspace:*",
		"@types/node": "catalog:",
		"oxfmt": "latest",
		"oxlint": "latest",
		"turbo": "^2.8.20",
		"typescript": "catalog:",
		"ultracite": "7.0.9"
	},
	"packageManager": "bun@1.3.11"
}
